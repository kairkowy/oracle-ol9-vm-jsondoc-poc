[Unit]
Description=JSONDoc upload application
After=network-online.target
Wants=network-online.target

[Service]
User=jsondoc
Group=jsondoc
WorkingDirectory=/opt/jsondoc/app
EnvironmentFile=/etc/jsondoc/app.env
ExecStart=/opt/jsondoc/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8501
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
